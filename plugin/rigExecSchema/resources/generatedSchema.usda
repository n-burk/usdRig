            string userDocBrief = "Which edge a trapezoid or triangle points at."
        }
    )
    uniform color4f ui:fill = (0.5, 0.5, 0.5, 1) (
        customData = {
            string userDocBrief = "Interior colour, linear, alpha premultiplied by the view."
        }
    )
    uniform float ui:fontSize = 8 (
        customData = {
            string userDocBrief = "Label size in panel units."
        }
    )
    uniform float2[] ui:polygon = [] (
        customData = {
            string userDocBrief = "Outline vertices for ui:shape = polygon, panel units."
        }
    )
    uniform float2 ui:position = (0, 0) (
        customData = {
            string userDocBrief = "Top-left corner in panel units."
        }
