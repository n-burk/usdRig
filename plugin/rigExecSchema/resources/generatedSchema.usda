        customData = {
            string userDocBrief = "Authoring lock metadata for DCC interchange."
        }
    )
    uniform token[] rigExec:preserve = ["origin", "scale"] (
        customData = {
            string userDocBrief = "Legacy component-preservation declaration retained for existing assets."
        }
    )
