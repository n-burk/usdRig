        allowedTokens = ["vector", "object"]
    )
    rel rigExec:poleVectorObjects (
        customData = {
            string userDocBrief = "Ordered pole-vector transform providers used in object mode."
        }
    )
    uniform token rigExec:rotationOrder = "XYZ" (
        allowedTokens = ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"]
        customData = {
            string userDocBrief = """Euler order for the operators that compose a rotation.\r
        Authoring it on one that does not is a compile error."""
        }
    )
    uniform token rigExec:solverMode = "rotatePlane" (
        allowedTokens = ["rotatePlane", "singleChain"]
    )
}

class RigExecFloatMathMover "RigExecFloatMathMover" (
    customData = {
        string userDocBrief = """Statically typed add, multiply, clamp, remap, blend, or curve\r
    over an exact float property target (spec section 4.1).\r
\r
    The revision is r = op(incoming), then the common MoverAPI envelope mixes\r
    it back over the incoming value."""
    }
)
{
    float2[] inputs:keys = [] (
        customData = {
            string userDocBrief = """(input, output) keys for the curve operation, strictly\r
        increasing in input."""
        }
    )
    float inputs:max = 1
    float inputs:min = 0
    float2[] inputs:tangents = [] (
        customData = {
            string userDocBrief = """Optional (in slope, out slope) per key for the curve\r
        operation."""
        }
    )
    float inputs:value = 0
    uniform token rigExec:operation = "clamp" (
        allowedTokens = ["add", "multiply", "clamp", "remap", "blend", "curve"]
    )
}

