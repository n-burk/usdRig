class RigExecSingleChainIkConstraint "RigExecSingleChainIkConstraint" (
    customData = {
        string userDocBrief = "FBX-style single-chain IK constraint."
    }
)
{
    float inputs:defaultWeight = 1 (
        customData = {
            string userDocBrief = """The constraint's envelope: the normalized blend from the
        incoming pose to the constrained pose, in [0, 1]."""
        }
    )
    double3 inputs:poleVector = (0, 1, 0) (
        customData = {
            string userDocBrief = "Absolute asset-space pole point used in vector mode."
        }
    )
    float[] inputs:poleVectorWeights = [] (
        customData = {
            string userDocBrief = "Weights parallel to rigExec:poleVectorObjects."
        }
    )
    double inputs:twistDegrees = 0
    rel rigExec:effector (
        customData = {
            string userDocBrief = "Single transform provider supplying the IK goal."
        }
    )
    rel rigExec:endJoint (
        customData = {
            string userDocBrief = "Single final joint of the inclusive IK chain."
        }
    )
    uniform token rigExec:evaluationMode = "neverTS" (
        allowedTokens = ["neverTS", "autoDetect", "alwaysTS"]
        customData = {
            string userDocBrief = """Controls whether animated per-chain translation and scale
        contribute to IK solve lengths, following Autodesk EvaluateTSAnim:
        neverTS ignores animated T/S and uses rest-derived lengths, autoDetect
        uses current T/S when animation is detected, and alwaysTS always uses
        the current T/S."""
        }
    )
    rel rigExec:firstJoint (
        customData = {
            string userDocBrief = "Single first joint of the inclusive IK chain."
        }
    )
    uniform bool rigExec:locked = 0 (
        customData = {
            string userDocBrief = "Authoring lock metadata for DCC interchange."
        }
    )
    uniform token rigExec:poleVectorMode = "vector" (
        allowedTokens = ["vector", "object"]
    )
    rel rigExec:poleVectorObjects (
        customData = {
            string userDocBrief = "Ordered pole-vector transform providers used in object mode."
        }
    )
    uniform token rigExec:solverMode = "rotatePlane" (
        allowedTokens = ["rotatePlane", "singleChain"]
    )
    rel rigExec:weightObject (
        customData = {
            string userDocBrief = """Optional per-element weight field refining
        inputs:defaultWeight, at most one."""
        }
    )
}

class RigExecCustomConstraint "RigExecCustomConstraint" (
    customData = {
        string userDocBrief = """Non-evaluating extensibility carrier for DCC-specific constraint
    metadata: RigExec intentionally assigns no source relationship or built-in
    solve semantics to this type, the built-in evaluator rejects a Custom prim
    carrying a rigExec:moves write set and exposes no handler registry, and an
    external integration must evaluate any Custom behavior outside the
    built-in RigExecRigEvaluator path while retaining the common weight/lock
    contract."""
    }
)
{
    float inputs:defaultWeight = 1 (
        customData = {
            string userDocBrief = """The constraint's envelope: the normalized blend from the
        incoming pose to the constrained pose, in [0, 1]."""
        }
    )
    uniform bool rigExec:locked = 0 (
        customData = {
            string userDocBrief = "Authoring lock metadata for DCC interchange."
        }
    )
    rel rigExec:weightObject (
        customData = {
            string userDocBrief = """Optional per-element weight field refining
        inputs:defaultWeight, at most one."""
        }
    )
}

class RigExecFloatMathMover "RigExecFloatMathMover" (
