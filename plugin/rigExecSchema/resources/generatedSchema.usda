    uniform float ui:depth = 0 (
        customData = {
            string userDocBrief = "Painter's-algorithm order; higher draws later, on top."
        }
    )
    uniform token ui:direction = "top" (
        allowedTokens = ["top", "bottom", "left", "right"]
