        customData = {
            string userDocBrief = "Single transform provider supplying the IK goal."
        }
    )
    rel rigExec:endJoint (
        customData = {
            string userDocBrief = "Single final joint of the inclusive IK chain."
        }
    )
    uniform token rigExec:evaluationMode = "neverTS" (
        allowedTokens = ["neverTS", "autoDetect", "alwaysTS"]
        customData = {
            string userDocBrief = """Controls whether animated per-chain translation and scale\r
        contribute to IK solve lengths, following Autodesk EvaluateTSAnim:\r
        neverTS ignores animated T/S and uses rest-derived lengths, autoDetect\r
        uses current T/S when animation is detected, and alwaysTS always uses\r
        the current T/S."""
        }
    )
    rel rigExec:firstJoint (
        customData = {
            string userDocBrief = "Single first joint of the inclusive IK chain."
        }
    )
    uniform bool rigExec:locked = 0 (
        customData = {
            string userDocBrief = "Authoring lock metadata for DCC interchange."
        }
    )
