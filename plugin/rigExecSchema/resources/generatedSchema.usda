        customData = {
            string userDocBrief = """ADDITIVE scale offset applied after the blend, which is why\r
        its identity is (0, 0, 0) and not (1, 1, 1): the kernel computes\r
        blendedScale + offset."""
        }
    )
    double3 inputs:translationOffset = (0, 0, 0) (
        customData = {
            string userDocBrief = "Additive translation offset applied after the source blend."
        }
    )
