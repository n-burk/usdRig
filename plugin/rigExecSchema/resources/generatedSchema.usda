    )
    token avars:rotationOrder = "XYZ" (
        allowedTokens = ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"]
    )
    double avars:rspin = 0
    double avars:rx = 0
    double avars:ry = 0
    double avars:rz = 0
    double avars:tx = 0
    double avars:ty = 0
    double avars:tz = 0
    double avars:unitScaleFactor = 1 (
        customData = {
            string userDocBrief = "Multiplier converting translation avars into local distance units before the selected default and parent transforms."
        }
    )
    double default:rx = 0
