    uniform token ui:shape = "rectangle" (
        allowedTokens = ["rectangle", "roundedRectangle", "circle", "ellipse", "hexagon", "triangle", "trapezoid", "polygon", "bezier", "widgetControl", "slider"]
        customData = {
            string userDocBrief = "Outline."
        }
    )
    uniform float2 ui:size = (10, 10) (
        customData = {
            string userDocBrief = "Width and height in panel units."
        }
    )
    uniform float ui:slopeLeft = 0 (
        customData = {
            string userDocBrief = "Trapezoid left-edge inset, as a fraction of ui:size width."
        }
    )
    uniform float ui:slopeRight = 0 (
        customData = {
            string userDocBrief = "Trapezoid right-edge inset, as a fraction of ui:size width."
        }
    )
    uniform color4f ui:stroke = (0, 0, 0, 0.8) (
