}

class RigExecSurfaceMover "RigExecSurfaceMover" (
    customData = {
        string userDocBrief = """Reads standard mesh properties for attachment/projection/\r
    sliding and surface-driven correction and writes an exact native\r
    UsdGeomPointBased points property (spec sections 4.1, 7.5)."""
    }
)
{
