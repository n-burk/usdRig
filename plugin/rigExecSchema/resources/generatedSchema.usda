class RigExecSplineIk "RigExecSplineIk" (
    customData = {
        string userDocBrief = """Control-driven spline IK for a spine or neck: the counterpart of
    The spline IK solver as the biped uses it."""
    }
)
{
    float3[] extent (
        customData = {
            string userDocBrief = """Extent is a three dimensional range measuring the geometric
        extent of the authored gprim in its own local space (i.e."""
        }
    )
    color3f guide:displayColor = (0.3, 0.6, 1)
    float guide:displayOpacity = 0.5
    double guide:radius = 1 (
        customData = {
            string userDocBrief = """Radius of the sphere and cone drawn at each aggregate
        element: the exact counterpart of RigExecJoint's guide:radius,
        including the rule that zero or negative draws no guides at all,
        which is how a solver's diagnostics are turned off."""
        }
    )
    double inputs:midFollowWeight = 0.5 (
        customData = {
            string userDocBrief = """Blend of the mid control's follow point between its rest
        origin carried by the root control (0) and by the end control (1):
        a parentConstraint with maintainOffset on both parents."""
        }
    )
    double inputs:minLengthRatio = 0 (
        customData = {
            string userDocBrief = """Length floor as a fraction of the rest root->end chord; 0
        switches it off."""
        }
    )
    double inputs:preserveVolume = 1 (
        customData = {
            string userDocBrief = """Strength of the linear volume preservation in [0, 1]:
        s_y = s_z = 1 - w_i * preserveVolume * (ratio - 1), s_x = 1."""
        }
    )
    double inputs:roll = 0 (
        customData = {
            string userDocBrief = """Additional roll in DEGREES about every joint's +X aim,
        added to the root control's own twist about the rest chain axis
        (the handle's roll)."""
        }
    )
    double inputs:twist = 0 (
        customData = {
            string userDocBrief = """Additional twist in DEGREES, linear in arc position from 0
        at the root to the full value at the curve end, added to the end
        control's twist minus the root's (the handle's twist)."""
        }
    )
    rel proxyPrim (
        customData = {
            string userDocBrief = '''The proxyPrim relationship allows us to link a
        prim whose purpose is "render" to its (single target)
        purpose="proxy" prim.'''
        }
    )
    uniform token purpose = "guide" (
        allowedTokens = ["default", "render", "proxy", "guide"]
        customData = {
            string userDocBrief = """Render purpose, overriding UsdGeomImageable's `default`
        fallback: joint and solver guides are DIAGNOSTICS, drawn when a
        viewer asks for guides."""
        }
    )
    rel rigExec:endControl (
        customData = {
            string userDocBrief = "Control carrying the curve end (cv2, cv3) and the end twist."
        }
    )
    uniform int[] rigExec:jointElements = [] (
        customData = {
            string userDocBrief = """Optional chain slot per rigExec:joints entry (parallel
        array)."""
        }
    )
    rel rigExec:joints (
        customData = {
            string userDocBrief = """Ordered chain, root to tip, posed by this solve (view-free
        extraction)."""
        }
    )
    rel rigExec:midControl (
        customData = {
            string userDocBrief = """Control whose translation offset from its follow point bends
        the interior (cv1, cv2)."""
        }
    )
    uniform token rigExec:restLength = "curve" (
        allowedTokens = ["curve", "chain"]
        customData = {
            string userDocBrief = "What the stretch ratio is measured against."
        }
    )
    rel rigExec:rootControl (
        customData = {
            string userDocBrief = "Control carrying the curve start (cv0, cv1) and the root roll."
        }
    )
    uniform token rigExec:rootTangent = "rigid" (
        allowedTokens = ["rigid", "aim"]
        customData = {
            string userDocBrief = "How cv1, the root's tangent CV, is posed."
        }
    )
    uniform float[] rigExec:volumeWeights = [] (
        customData = {
            string userDocBrief = """Per-joint squash/stretch weight w_i, parallel to
        rigExec:joints (in chain-slot order)."""
        }
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
        customData = {
            string userDocBrief = '''Visibility is meant to be the simplest form of "pruning" 
        visibility that is supported by most DCC apps.'''
        }
    )
    uniform token[] xformOpOrder (
        customData = {
            string userDocBrief = """Encodes the sequence of transformation operations in the
        order in which they should be pushed onto a transform stack while
        visiting a UsdStage's prims in a graph traversal that will effect
        the desired positioning for this prim and its descendant prims."""
        }
    )
}

class "RigExecConstraint" (
    customData = {
        string userDocBrief = "Abstract common contract for FBX-style pose constraints."
    }
)
{
    bool inputs:affectRotationX = 1 (
        customData = {
            string userDocBrief = "Per-axis rotation mask."
        }
    )
    bool inputs:affectRotationY = 1
    bool inputs:affectRotationZ = 1
    bool inputs:affectScaleX = 1 (
        customData = {
            string userDocBrief = "Per-axis scale mask."
        }
    )
    bool inputs:affectScaleY = 1
    bool inputs:affectScaleZ = 1
    bool inputs:affectTranslationX = 1 (
        customData = {
            string userDocBrief = "Per-axis translation mask."
        }
    )
    bool inputs:affectTranslationY = 1
    bool inputs:affectTranslationZ = 1
    double3 inputs:rotationOffset = (0, 0, 0) (
        customData = {
            string userDocBrief = "Additive Euler rotation offset in degrees, applied after the blend."
        }
    )
    double3 inputs:scaleOffset = (0, 0, 0) (
        customData = {
            string userDocBrief = """ADDITIVE scale offset applied after the blend, which is why
        its identity is (0, 0, 0) and not (1, 1, 1): the kernel computes
        blendedScale + offset."""
        }
    )
    double3 inputs:translationOffset = (0, 0, 0) (
        customData = {
            string userDocBrief = "Additive translation offset applied after the source blend."
        }
    )
    uniform bool rigExec:locked = 0 (
        customData = {
            string userDocBrief = "Authoring lock metadata for DCC interchange."
        }
    )
    uniform token rigExec:rotationOrder = "XYZ" (
        allowedTokens = ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"]
        customData = {
            string userDocBrief = "Euler order for the operators that compose a rotation."
        }
    )
}

