        read when rigExec:falloffProfile is `curve`."""
        }
    )
    uniform token rigExec:falloffProfile = "smooth" (
        allowedTokens = ["linear", "smooth", "easeIn", "easeOut", "constant", "curve"]
        customData = {
            string userDocBrief = """Named analytic remap of the normalized band parameter, or
        `curve` to use the spline authored on rigExec:falloffCurve."""
        }
    )
    uniform token rigExec:rangePolicy = "clamp" (
        allowedTokens = ["strict", "clamp"]
        customData = {
            string userDocBrief = """Defaults to clamp rather than the strict used by the
        authored weight objects: inputs:strength and inputs:invert are
        animatable, and an artist scrubbing strength past one should see
        the field saturate, not invalidate the rig mid-drag."""
        }
    )
    uniform token rigExec:representation = "dense" (
        allowedTokens = ["dense"]
