        Authoring it on one that does not is a compile error."""
        }
    )
    rel rigExec:sources (
        customData = {
            string userDocBrief = "Ordered transform sources."
        }
    )
    uniform token rigExec:upPolicy = "preserveInputUp" (
        allowedTokens = ["preserveInputUp"]
        customData = {
            string userDocBrief = "Legacy up policy retained for existing assets."
        }
    )
    rel rigExec:worldUpObject (
        customData = {
            string userDocBrief = "Optional single transform provider used by object world-up modes."
        }
    )
    uniform token rigExec:worldUpType = "none" (
        allowedTokens = ["sceneUp", "objectUp", "objectRotationUp", "vector", "none"]
    )
}

