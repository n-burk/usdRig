        customData = {
            string userDocBrief = """Distance at which the field is fully OFF; the outer
        radius for a sphere."""
        }
    )
    float inputs:falloffMin = 0 (
        customData = {
            string userDocBrief = "Distance at which the field is fully ON."
        }
    )
    float inputs:invert = 0 (
        customData = {
            string userDocBrief = "Exchanges the two ends of the band."
        }
    )
    float inputs:scaleX = 1 (
        customData = {
            string userDocBrief = """Per-axis divisor applied to the local coordinate before
