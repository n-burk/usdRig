        }
    )
    uniform float ui:strokeWidth = 1 (
        customData = {
            string userDocBrief = "Outline width in panel units."
        }
    )
    uniform string ui:text = "" (
        customData = {
            string userDocBrief = "Label drawn inside the button."
        }
    )
    uniform token ui:textAlign = "center" (
        allowedTokens = ["left", "center", "right"]
        customData = {
            string userDocBrief = "Horizontal label alignment inside the button."
        }
    )
    uniform color4f ui:textColor = (0, 0, 0, 1) (
        customData = {
            string userDocBrief = "Label colour."
        }
    )
    uniform color4f ui:valueColor = (0, 0, 0, 1) (
        customData = {
            string userDocBrief = """Colour of the VALUE a switch or dial displays, as
        distinct from its label: `Foot` is drawn in ui:textColor and the
