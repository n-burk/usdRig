class RigExecBlendPointFrames "RigExecBlendPointFrames" (
    customData = {
        string userDocBrief = """IK/FK or general frame blend of two aggregate providers.\r
    Publishes computePointFrameArray."""
    }
)
{
    float3[] extent (
        customData = {
            string userDocBrief = """Extent is a three dimensional range measuring the geometric
        extent of the authored gprim in its own local space (i.e."""
        }
    )
    color3f guide:displayColor = (0.3, 0.6, 1)
    float guide:displayOpacity = 0.5
    double guide:radius = 1 (
        customData = {
            string userDocBrief = """Radius of the sphere and cone drawn at each aggregate\r
        element: the exact counterpart of RigExecJoint's guide:radius,\r
        including the rule that zero or negative draws no guides at all,\r
        which is how a solver's diagnostics are turned off.\r
\r
        Without it the elements are stuck at Hydra's fallback radius of\r
        1.0."""
        }
    )
    float inputs:weight = 0
    rel proxyPrim (
        customData = {
            string userDocBrief = '''The proxyPrim relationship allows us to link a
        prim whose purpose is "render" to its (single target)
        purpose="proxy" prim.'''
        }
    )
    uniform token purpose = "guide" (
        allowedTokens = ["default", "render", "proxy", "guide"]
        customData = {
            string userDocBrief = """Render purpose, overriding UsdGeomImageable's `default`\r
        fallback: joint and solver guides are DIAGNOSTICS, drawn when a\r
        viewer asks for guides.\r
\r
        This is the stock attribute rather than a RigExec-specific token so\r
        that the bounds and the drawing cannot disagree: UsdGeomBBoxCache\r
        classifies a prim's extent by this exact attribute, and the results\r
        scene index stamps the same resolved value onto the guide it\r
        synthesizes."""
        }
    )
    rel rigExec:inputA
    rel rigExec:inputB
    rel rigExec:joints (
        customData = {
            string userDocBrief = """Ordered output joints posed by the blended result (view-free\r
        extraction)."""
        }
    )
    uniform token rigExec:rotationBlend = "shortestArc" (
        allowedTokens = ["shortestArc"]
    )
    uniform token rigExec:scaleBlend = "log" (
        allowedTokens = ["log", "linear"]
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
        customData = {
            string userDocBrief = '''Visibility is meant to be the simplest form of "pruning" 
        visibility that is supported by most DCC apps.'''
        }
    )
    uniform token[] xformOpOrder (
        customData = {
            string userDocBrief = """Encodes the sequence of transformation operations in the
        order in which they should be pushed onto a transform stack while
        visiting a UsdStage's prims in a graph traversal that will effect
        the desired positioning for this prim and its descendant prims."""
        }
    )
}

