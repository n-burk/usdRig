#usda 1.0
(
    defaultPrim = "Rig"
    upAxis = "Y"
)
def RigExecRoot "Rig"
{
    def RigExecControl "Wire"
    {
        uniform token guide:shape = "custom"
        double guide:wireWidth = 0
        point3f[] guide:points = [(-2, 1, 0), (2, 1, 0)]
        int[] guide:curveVertexCounts = [2]
        uniform token purpose = "guide"
    }
    def RigExecControl "Hidden"
    {
        uniform token guide:shape = "custom"
        double guide:wireWidth = 0
        point3f[] guide:points = [(-2, -1, -1), (2, -1, -1)]
        int[] guide:curveVertexCounts = [2]
        uniform token purpose = "guide"
    }
    def Cube "Surface"
    {
        double size = 1
        double3 xformOp:scale = (6, 4, 0.2)
        double3 xformOp:translate = (0, 0, -0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
