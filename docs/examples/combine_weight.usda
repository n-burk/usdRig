            point3f[] points = [(-3.6, 0, -1.6), (-3.3, 0, -1.6), (-3, 0, -1.6), (-2.7, 0, -1.6), (-2.4, 0, -1.6), (-2.1, 0, -1.6), (-1.8, 0, -1.6), (-1.5, 0, -1.6), (-1.2, 0, -1.6), (-0.9, 0, -1.6), (-0.6, 0, -1.6), (-0.3, 0, -1.6), (-0, 0, -1.6), (0.3, 0, -1.6), (0.6, 0, -1.6), (0.9, 0, -1.6), (1.2, 0, -1.6), (1.5, 0, -1.6), (1.8, 0, -1.6), (2.1, 0, -1.6), (2.4, 0, -1.6), (2.7, 0, -1.6), (3, 0, -1.6), (3.3, 0, -1.6), (3.6, 0, -1.6), (-3.6, 0, -1.2), (-3.3, 0, -1.2), (-3, 0, -1.2), (-2.7, 0, -1.2), (-2.4, 0, -1.2), (-2.1, 0, -1.2), (-1.8, 0, -1.2), (-1.5, 0, -1.2), (-1.2, 0, -1.2), (-0.9, 0, -1.2), (-0.6, 0, -1.2), (-0.3, 0, -1.2), (-0, 0, -1.2), (0.3, 0, -1.2), (0.6, 0, -1.2), (0.9, 0, -1.2), (1.2, 0, -1.2), (1.5, 0, -1.2), (1.8, 0, -1.2), (2.1, 0, -1.2), (2.4, 0, -1.2), (2.7, 0, -1.2), (3, 0, -1.2), (3.3, 0, -1.2), (3.6, 0, -1.2), (-3.6, 0, -0.8), (-3.3, 0, -0.8), (-3, 0, -0.8), (-2.7, 0, -0.8), (-2.4, 0, -0.8), (-2.1, 0, -0.8), (-1.8, 0, -0.8), (-1.5, 0, -0.8), (-1.2, 0, -0.8), (-0.9, 0, -0.8), (-0.6, 0, -0.8), (-0.3, 0, -0.8), (-0, 0, -0.8), (0.3, 0, -0.8), (0.6, 0, -0.8), (0.9, 0, -0.8), (1.2, 0, -0.8), (1.5, 0, -0.8), (1.8, 0, -0.8), (2.1, 0, -0.8), (2.4, 0, -0.8), (2.7, 0, -0.8), (3, 0, -0.8), (3.3, 0, -0.8), (3.6, 0, -0.8), (-3.6, 0, -0.4), (-3.3, 0, -0.4), (-3, 0, -0.4), (-2.7, 0, -0.4), (-2.4, 0, -0.4), (-2.1, 0, -0.4), (-1.8, 0, -0.4), (-1.5, 0, -0.4), (-1.2, 0, -0.4), (-0.9, 0, -0.4), (-0.6, 0, -0.4), (-0.3, 0, -0.4), (-0, 0, -0.4), (0.3, 0, -0.4), (0.6, 0, -0.4), (0.9, 0, -0.4), (1.2, 0, -0.4), (1.5, 0, -0.4), (1.8, 0, -0.4), (2.1, 0, -0.4), (2.4, 0, -0.4), (2.7, 0, -0.4), (3, 0, -0.4), (3.3, 0, -0.4), (3.6, 0, -0.4), (-3.6, 0, 0), (-3.3, 0, 0), (-3, 0, 0), (-2.7, 0, 0), (-2.4, 0, 0), (-2.1, 0, 0), (-1.8, 0, 0), (-1.5, 0, 0), (-1.2, 0, 0), (-0.9, 0, 0), (-0.6, 0, 0), (-0.3, 0, 0), (-0, 0, 0), (0.3, 0, 0), (0.6, 0, 0), (0.9, 0, 0), (1.2, 0, 0), (1.5, 0, 0), (1.8, 0, 0), (2.1, 0, 0), (2.4, 0, 0), (2.7, 0, 0), (3, 0, 0), (3.3, 0, 0), (3.6, 0, 0), (-3.6, 0, 0.4), (-3.3, 0, 0.4), (-3, 0, 0.4), (-2.7, 0, 0.4), (-2.4, 0, 0.4), (-2.1, 0, 0.4), (-1.8, 0, 0.4), (-1.5, 0, 0.4), (-1.2, 0, 0.4), (-0.9, 0, 0.4), (-0.6, 0, 0.4), (-0.3, 0, 0.4), (-0, 0, 0.4), (0.3, 0, 0.4), (0.6, 0, 0.4), (0.9, 0, 0.4), (1.2, 0, 0.4), (1.5, 0, 0.4), (1.8, 0, 0.4), (2.1, 0, 0.4), (2.4, 0, 0.4), (2.7, 0, 0.4), (3, 0, 0.4), (3.3, 0, 0.4), (3.6, 0, 0.4), (-3.6, 0, 0.8), (-3.3, 0, 0.8), (-3, 0, 0.8), (-2.7, 0, 0.8), (-2.4, 0, 0.8), (-2.1, 0, 0.8), (-1.8, 0, 0.8), (-1.5, 0, 0.8), (-1.2, 0, 0.8), (-0.9, 0, 0.8), (-0.6, 0, 0.8), (-0.3, 0, 0.8), (-0, 0, 0.8), (0.3, 0, 0.8), (0.6, 0, 0.8), (0.9, 0, 0.8), (1.2, 0, 0.8), (1.5, 0, 0.8), (1.8, 0, 0.8), (2.1, 0, 0.8), (2.4, 0, 0.8), (2.7, 0, 0.8), (3, 0, 0.8), (3.3, 0, 0.8), (3.6, 0, 0.8), (-3.6, 0, 1.2), (-3.3, 0, 1.2), (-3, 0, 1.2), (-2.7, 0, 1.2), (-2.4, 0, 1.2), (-2.1, 0, 1.2), (-1.8, 0, 1.2), (-1.5, 0, 1.2), (-1.2, 0, 1.2), (-0.9, 0, 1.2), (-0.6, 0, 1.2), (-0.3, 0, 1.2), (-0, 0, 1.2), (0.3, 0, 1.2), (0.6, 0, 1.2), (0.9, 0, 1.2), (1.2, 0, 1.2), (1.5, 0, 1.2), (1.8, 0, 1.2), (2.1, 0, 1.2), (2.4, 0, 1.2), (2.7, 0, 1.2), (3, 0, 1.2), (3.3, 0, 1.2), (3.6, 0, 1.2), (-3.6, 0, 1.6), (-3.3, 0, 1.6), (-3, 0, 1.6), (-2.7, 0, 1.6), (-2.4, 0, 1.6), (-2.1, 0, 1.6), (-1.8, 0, 1.6), (-1.5, 0, 1.6), (-1.2, 0, 1.6), (-0.9, 0, 1.6), (-0.6, 0, 1.6), (-0.3, 0, 1.6), (-0, 0, 1.6), (0.3, 0, 1.6), (0.6, 0, 1.6), (0.9, 0, 1.6), (1.2, 0, 1.6), (1.5, 0, 1.6), (1.8, 0, 1.6), (2.1, 0, 1.6), (2.4, 0, 1.6), (2.7, 0, 1.6), (3, 0, 1.6), (3.3, 0, 1.6), (3.6, 0, 1.6)]
            uniform token subdivisionScheme = "none"
        }
    }

    def Camera "MainCam"
    {
        float2 clippingRange = (0.1831, 159)
        float focalLength = 35
        float horizontalAperture = 20.95
        float verticalAperture = 11.79
        double3 xformOp:rotateXYZ = (-20, 32, 0)
        double3 xformOp:translate = (9.363, 6.537, 14.41)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
