#usda 1.0
(
    """
    Docs example: RigExecCurveWeight.

    A flat 13x13 sheet is weighted by distance to a curve. The curve is a plain
    UsdGeomBasisCurves whose points are animated: it sweeps across the
    sheet and back. Everything in the rig is static -- the Lift control
    holds avars:ty = 0.8 for the whole shot -- so the only thing that
    changes is WHICH points the field grabs, and a ridge travels across
    the sheet with the curve.

    inputs:falloffMin is the distance at which the field is fully ON and
    inputs:falloffMax where it is fully OFF, both measured to the nearest
    point on the POLYLINE through the curve's control points. The tube
    drawn at those two distances (Display -> Display Purposes -> Guide)
    is therefore exactly the region the ridge covers. The curve rides at
    y = 0.3 so it stays visible above the sheet it weights, and
    falloffMin matches that height so points directly under it read 1.0.
    """
    defaultPrim = "CurveWeightAsset"
    endTimeCode = 1024
    metersPerUnit = 0.01
    startTimeCode = 1001
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "CurveWeightAsset"
{
