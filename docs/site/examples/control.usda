                uniform asset ui:nodegraph:node:icon = @../../icons/control.png@
            }
        }

        def Scope "Solvers"
        {
            def RigExecFkChain "SphereChain" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                rel rigExec:controls = </ControlAsset/Rig/Controls/sphere_wire>
                rel rigExec:joints = </ControlAsset/Rig/Joints/SphereJnt>
                uniform asset ui:nodegraph:node:icon = @../../icons/fk_chain.png@
            }

            def RigExecFkChain "CircleChain" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                rel rigExec:controls = </ControlAsset/Rig/Controls/circle_wire>
                rel rigExec:joints = </ControlAsset/Rig/Joints/CircleJnt>
                uniform asset ui:nodegraph:node:icon = @../../icons/fk_chain.png@
            }

            def RigExecFkChain "BoxChain" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                rel rigExec:controls = </ControlAsset/Rig/Controls/box_wire>
                rel rigExec:joints = </ControlAsset/Rig/Joints/BoxJnt>
