                def RigExecMatrixMover "PyramidSkin" (
                    prepend apiSchemas = ["RigExecMoverAPI", "NodeGraphNodeAPI"]
                )
                {
                    rel rigExec:moves = </ControlAsset/Geom/PyramidCard.points>
