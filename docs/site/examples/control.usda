        def Scope "Movers"
        {
            def Scope "Geometry"
            {
                def RigExecMatrixMover "SphereSkin" (
                    prepend apiSchemas = ["RigExecMoverAPI", "NodeGraphNodeAPI"]
                )
                {
                    rel rigExec:moves = </ControlAsset/Geom/SphereCard.points>
                    rel rigExec:transform = </ControlAsset/Rig/Joints/SphereJnt>
                    uniform token rigExec:transformReadPhase = "final"
                    rel rigExec:weightObject = </ControlAsset/Rig/Weights/SphereW>
                    uniform asset ui:nodegraph:node:icon = @../../icons/matrix_mover.png@
                }

                def RigExecMatrixMover "CircleSkin" (
