    def Scope "Geom"
    {
        def Mesh "SphereCard"
        {
            color3f[] primvars:displayColor = [(0.2, 0.55, 1)]
            float3[] extent = [(-3.75, -1.75, -0.35), (-2.75, -1.75, 0.35)]
