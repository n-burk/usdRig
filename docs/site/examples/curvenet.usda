                interpolation = "vertex"
            )
            point3f[] points = [(1.1, 0, 0), (0.952628, 0, 0.55), (0.55, 0, 0.952628), (6.73556e-17, 0, 1.1), (-0.55, 0, 0.952628), (-0.952628, 0, 0.55), (-1.1, 0, 1.34711e-16), (-0.952628, 0, -0.55), (-0.55, 0, -0.952628), (-2.02067e-16, 0, -1.1), (0.55, 0, -0.952628), (0.952628, 0, -0.55), (1.1, 0.625, 0), (0.952628, 0.625, 0.55), (0.55, 0.625, 0.952628), (6.73556e-17, 0.625, 1.1), (-0.55, 0.625, 0.952628), (-0.952628, 0.625, 0.55), (-1.1, 0.625, 1.34711e-16), (-0.952628, 0.625, -0.55), (-0.55, 0.625, -0.952628), (-2.02067e-16, 0.625, -1.1), (0.55, 0.625, -0.952628), (0.952628, 0.625, -0.55), (1.1, 1.25, 0), (0.952628, 1.25, 0.55), (0.55, 1.25, 0.952628), (6.73556e-17, 1.25, 1.1), (-0.55, 1.25, 0.952628), (-0.952628, 1.25, 0.55), (-1.1, 1.25, 1.34711e-16), (-0.952628, 1.25, -0.55), (-0.55, 1.25, -0.952628), (-2.02067e-16, 1.25, -1.1), (0.55, 1.25, -0.952628), (0.952628, 1.25, -0.55), (1.1, 1.875, 0), (0.952628, 1.875, 0.55), (0.55, 1.875, 0.952628), (6.73556e-17, 1.875, 1.1), (-0.55, 1.875, 0.952628), (-0.952628, 1.875, 0.55), (-1.1, 1.875, 1.34711e-16), (-0.952628, 1.875, -0.55), (-0.55, 1.875, -0.952628), (-2.02067e-16, 1.875, -1.1), (0.55, 1.875, -0.952628), (0.952628, 1.875, -0.55), (1.1, 2.5, 0), (0.952628, 2.5, 0.55), (0.55, 2.5, 0.952628), (6.73556e-17, 2.5, 1.1), (-0.55, 2.5, 0.952628), (-0.952628, 2.5, 0.55), (-1.1, 2.5, 1.34711e-16), (-0.952628, 2.5, -0.55), (-0.55, 2.5, -0.952628), (-2.02067e-16, 2.5, -1.1), (0.55, 2.5, -0.952628), (0.952628, 2.5, -0.55), (1.1, 3.125, 0), (0.952628, 3.125, 0.55), (0.55, 3.125, 0.952628), (6.73556e-17, 3.125, 1.1), (-0.55, 3.125, 0.952628), (-0.952628, 3.125, 0.55), (-1.1, 3.125, 1.34711e-16), (-0.952628, 3.125, -0.55), (-0.55, 3.125, -0.952628), (-2.02067e-16, 3.125, -1.1), (0.55, 3.125, -0.952628), (0.952628, 3.125, -0.55), (1.1, 3.75, 0), (0.952628, 3.75, 0.55), (0.55, 3.75, 0.952628), (6.73556e-17, 3.75, 1.1), (-0.55, 3.75, 0.952628), (-0.952628, 3.75, 0.55), (-1.1, 3.75, 1.34711e-16), (-0.952628, 3.75, -0.55), (-0.5