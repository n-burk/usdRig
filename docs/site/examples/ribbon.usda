            point3f[] points = [
                (-0.55, 0, 0), (0.55, 0, 0), (-0.55, 0.2917, 0), (0.55, 0.2917, 0),
                (-0.55, 0.5833, 0), (0.55, 0.5833, 0), (-0.55, 0.875, 0),
