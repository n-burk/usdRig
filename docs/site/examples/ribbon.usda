    def Camera "MainCam"
    {
        float2 clippingRange = (0.2793, 234.7)
        float focalLength = 35
        float horizontalAperture = 20.95
        float verticalAperture = 11.79
        double3 xformOp:rotateXYZ = (-20, 32, 0)
        double3 xformOp:translate = (13.21, 13.03, 22.18)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
