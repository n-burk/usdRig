            normal3f[] normals = [(1, 0, 0), (0.92388, 0, 0.382683), (0.707107, 0, 0.707107), (0.382683, 0, 0.92388), (6.12323e-17, 0, 1), (-0.382683, 0, 0.92388), (-0.707107, 0, 0.707107), (-0.92388, 0, 0.382683), (-1, 0, 1.22465e-16), (-0.92388, 0, -0.382683), (-0.707107, 0, -0.707107), (-0.382683, 0, -0.92388), (-1.83697e-16, 0, -1), (0.382683, 0, -0.92388), (0.707107, 0, -0.707107), (0.92388, 0, -0.382683), (1, 0, 0), (0.92388, 0, 0.382683), (0.707107, 0, 0.707107), (0.382683, 0, 0.92388), (6.12323e-17, 0, 1), (-0.382683, 0, 0.92388), (-0.707107, 0, 0.707107), (-0.92388, 0, 0.382683), (-1, 0, 1.22465e-16), (-0.92388, 0, -0.382683), (-0.707107, 0, -0.707107), (-0.382683, 0, -0.92388), (-1.83697e-16, 0, -1), (0.382683, 0, -0.92388), (0.707107, 0, -0.707107), (0.92388, 0, -0.382683), (1, 0, 0), (0.92388, 0, 0.382683), (0.707107, 0, 0.707107), (0.382683, 0, 0.92388), (6.12323e-17, 0, 1), (-0.382683, 0, 0.92388), (-0.707107, 0, 0.707107), (-0.92388, 0, 0.382683), (-1, 0, 1.22465e-16), (-0.92388, 0, -0.382683), (-0.707107, 0, -0.707107), (-0.382683, 0, -0.92388), (-1.83697e-16, 0, -1), (0.382683, 0, -0.92388), (0.707107, 0, -0.707107), (0.92388, 0, -0.382683), (1, 0, 0), (0.92388, 0, 0.382683), (0.707107, 0, 0.707107), (0.382683, 0, 0.92388), (6.12323e-17, 0, 1), (-0.382683, 0, 0.92388), (-0.707107, 0, 0.707107), (-0.92388, 0, 0.382683), (-1, 0, 1.22465e-16), (-0.92388, 0, -0.382683), (-0.707107, 0, -0.707107), (-0.382683, 0, -0.92388), (-1.83697e-16, 0, -1), (0.382683, 0, -0.92388), (0.707107, 0, -0.707107), (0.92388, 0, -0.382683), (1, 0, 0), (0.92388, 0, 0.382683), (0.707107, 0, 0.707107), (0.382683, 0, 0.92388), (6.12323e-17, 0, 1), (-0.382683, 0, 0.92388), (-0.707107, 0, 0.707107), (-0.92388, 0, 0.382683), (-1, 0, 1.22465e-16), (-0.92388, 0, -0.382683), (-0.707107, 0, -0.707107), (-0.382683, 0, -0.92388), (-1.83697e-16, 0, -1), (0.382683, 0, -0.92388), (0.707107, 0, -0.707107), (0.92388, 0, -0.382683), (1, 0, 0), (0.92388, 0, 0.382683), (0.707107, 0, 0.707107), (