#usda 1.0
(
    defaultPrim = "Biped"
    doc = """The face, as one branch of the biped's layer tree, over the
    body. Strongest first:

      Biped_face_picker.usda          the Face panel of the control picker
      Biped_face_touch_regions.usda   TouchPose regions on the face's
                                      controls
      Biped_face_psd.usda             the face's pose interpolators and
                                      their driver controls
      Biped_face_shapes.usdc          the face's corrective blend shapes
      Biped_cheeks.usda   the cluster controls around the cheeks, nose and
                          ears: cheeks, cheek puff and lift, mask flare,
                          sneer, nostril flare, septum, chin, ears
      Biped_brows.usda    the brows' cluster controls: the corrugators
      Biped_mouth.usda    mouthMain, the lip clusters, the mouth corners
                          driving lip main, and the lip curve's tweaks
      Biped_eyes.usda     the lids and the blink, the socket stretch and
                          lift, the eye drag, lid squash, and the lid and
                          socket curves' tweaks
      Biped_jaw.usda      the jaw's automatic compression
      Biped_face.usda     the face's skeleton controls: jaw, mid-face,
                          nose, brows, eye look-ats

    The parts above expect the ones below, so drop from the top. The
    picker and touch layers can be muted on their own; the psd and shapes
    layers go together."""
    subLayers = [
        @./Biped_lashes.usda@,
        @./Biped_face_parts.usda@,
        @./Biped_face_picker.usda@,
        @./Biped_face_touch_regions.usda@,
        @./Biped_face_psd.usda@,
        @./Biped_face_shapes.usdc@,
        @./Biped_cheeks.usda@,
        @./Biped_brows.usda@,
        @./Biped_mouth.usda@,
        @./Biped_eyes.usda@,
        @./Biped_jaw.usda@,
        @./Biped_face.usda@
    ]
)

