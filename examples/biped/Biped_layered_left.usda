        over "Solvers"
        {
            def RigExecTwoBoneIk "arm_l_twoBoneIk" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                rel rigExec:effectorControl = </Biped/Rig/Controls/arm_l_ik>
                rel rigExec:joints = [
                    </Biped/Rig/Joints/hips_bind/spine_0_bind/spine_1_bind/spine_2_bind/spine_3_bind/spine_4_bind/spine_5_bind/chest_bind/clavicle_l_bind/shoulder_l_bind>,
                    </Biped/Rig/Joints/hips_bind/spine_0_bind/spine_1_bind/spine_2_bind/spine_3_bind/spine_4_bind/spine_5_bind/chest_bind/clavicle_l_bind/shoulder_l_bind/elbow_l_bind>,
                    </Biped/Rig/Joints/hips_bind/spine_0_bind/spine_1_bind/spine_2_bind/spine_3_bind/spine_4_bind/spine_5_bind/chest_bind/clavicle_l_bind/shoulder_l_bind/elbow_l_bind/wrist_l_bind>,
                ]
                rel rigExec:poleControl = </Biped/Rig/Controls/arm_l_pv>
                double rigExec:preferredBendRadians = 0
                rel rigExec:rootControl = </Biped/Rig/Controls/hips_ctl/torso_ctl/spine_end_pivot/spine_end_ctl/clavicle_l_ctl/arm_l_root>
                uniform float2 ui:nodegraph:node:pos = (1.78, 0.22)
            }

            def RigExecFkChain "arm_l_fkChain" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                rel rigExec:controls = [
                    </Biped/Rig/Controls/hips_ctl/torso_ctl/spine_end_pivot/spine_end_ctl/clavicle_l_ctl/arm_l_root/arm_l_fk_shoulder_l_bind>,
                    </Biped/Rig/Controls/hips_ctl/torso_ctl/spine_end_pivot/spine_end_ctl/clavicle_l_ctl/arm_l_root/arm_l_fk_shoulder_l_bind/arm_l_fk_elbow_l_bind>,
                    </Biped/Rig/Controls/hips_ctl/torso_ctl/spine_end_pivot/spine_end_ctl/clavicle_l_ctl/arm_l_root/arm_l_fk_shoulder_l_bind/arm_l_fk_elbow_l_bind/arm_l_fk_wrist_l_bind>,
                ]
                uniform token rigExec:controlSpace = "parentRelative"
                rel rigExec:joints = [
