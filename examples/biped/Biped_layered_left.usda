            def RigExecControl "leg_l_params" (
                prepend apiSchemas = ["RigExecControlAPI", "NodeGraphNodeAPI"]
            )
            {
                custom float avars:footRock = 0 (
                    customData = {
                        dictionary limits = {
                            dictionary hard = {
                                double maximum = 90
                                double minimum = -90
                            }
                            dictionary soft = {
                                double maximum = 90
                                double minimum = -90
                            }
                        }
                    }
                    doc = "Foot rock in degrees: positive tips the foot onto its outer edge, negative onto the inner (the conventional tool leg_?.footRock, whose +-90 reaches 80.9 deg through the bank remap)."
                )
                custom float avars:footRoll = 0 (
                    customData = {
                        dictionary limits = {
                            dictionary hard = {
                                double maximum = 120
                                double minimum = -120
                            }
                            dictionary soft = {
                                double maximum = 120
                                double minimum = -120
                            }
                        }
                    }
                    doc = "Foot roll in degrees: negative rocks onto the heel, positive rolls over the ball and, past avars:toePlantAngle, onto the toe tip (the conventional tool leg_?.footRoll)."
                )
                custom float avars:ikfk = 1 (
                    customData = {
                        dictionary limits = {
                            dictionary hard = {
                                double maximum = 1
                                double minimum = 0
                            }
                            dictionary soft = {
                                double maximum = 1
                                double minimum = 0
                            }
                        }
                    }
                )
                custom float avars:toePlantAngle = 60 (
                    customData = {
                        dictionary limits = {
                            dictionary hard = {
                                double maximum = 120
                                double minimum = 0
                            }
                            dictionary soft = {
                                double maximum = 120
                                double minimum = 0
                            }
                        }
                    }
                    doc = "Roll angle at which the ball stops and the toe takes over (the conventional tool leg_?.toePlantAngle)."
                )
                color3f guide:displayColor = (1, 0.85, 0.1)
                double guide:scaleX = 3
                double guide:scaleY = 3
                double guide:scaleZ = 3
                uniform token guide:shape = "cube"
                matrix4d rest:space = ( (2.2204460492503128e-16, -1, -1.5715914943427146e-16, 0), (-2.2204460492503128e-16, -1.4501608510243386e-16, 1, 0), (-1.0000000000000004, -2.220446049250313e-16, -2.220446049250313e-16, 0), (19.752600000000022, 9.485777623542617, -7.084254793708138, 1) )
            }
