#usda 1.0
(
    doc = "The right shoulder's pose rotations, rebased into the frame this port's arm_r_root actually uses. Stronger than Biped_body_psd.usda on purpose, so a rebuild cannot drop the correction."
)

over "Biped"
{
    over "Rig"
    {
        over "PoseInterpolators"
        {
            over "shoulder_r_driver"
            {
                over "shoulder_r_up_45"
                {
                    quatf rigExec:rotation = (0.7048652, -0.0052987975, -0.7089708, 0.022300825)
                }

                over "shoulder_r_down_90"
                {
                    quatf rigExec:rotation = (0.92474383, -0.022631055, 0.3798992, 0.0036387779)
                }

                over "shoulder_r_forward_135"
                {
                    quatf rigExec:rotation = (0.3701955, 0.35079765, -0.1598412, -0.8451906)
                }

                over "shoulder_r_back_135"
                {
                    quatf rigExec:rotation = (0.33587226, -0.36107618, -0.13502663, 0.8594077)
                }

                over "shoulder_r_down_135"
                {
                    quatf rigExec:rotation = (0.7089708, -0.022300836, 0.7048652, -0.0052988087)
                }

                over "shoulder_r_up_0"
                {
                    quatf rigExec:rotation = (0.92252195, -0.013429567, -0.38526335, 0.018575575)
                }

                over "shoulder_r_forward_90"
                {
                    quatf rigExec:rotation = (0.6654565, 0.2629262, -0.28191847, -0.6391866)
                }
            }
        }
    }
}

