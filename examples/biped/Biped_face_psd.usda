#usda 1.0
(
    defaultPrim = "Biped"
    doc = "The face's pose-space correctives: hidden driver controls copying the mouth corner, jaw, brow, corrugator and lip channels, and one pose interpolator per corrective set, wired to the face blend shapes in Biped_face_shapes.usdc. Adds prims and overrides nothing, so dropping this sublayer leaves the character exactly as it was."
)

over "Biped"
{
    over "Rig"
