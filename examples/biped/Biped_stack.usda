#usda 1.0
(
    defaultPrim = "Biped"
    doc = """The whole character: two branches, each a tree of its own\r
    layers.\r
\r
      Biped_squetch.usda    the head squetch and the neck slide, which\r
                            read the body's head wire and deform the face,\r
                            so they sit above both branches\r
      Biped_spaces.usda     the space switches, which span both branches:\r
                            an arm's IK handle can sit in the head's space,\r
                            so this layer is stronger than either\r
      Biped_face_rig.usda   the face: its picker panel, touch regions and\r
                            the face rig parts\r
      Biped_body.usda       the body: its picker panel, touch regions,\r
                            correctives, left, right and center rig\r
                            layers, and the model\r
\r
    The face is stronger because it is built over the body. Each branch\r
    carries every kind of data for its part, so the body opens on its own\r
    and the face can be muted as a whole or layer by layer."""
    metersPerUnit = 0.01
    subLayers = [
        @./Biped_spaces.usda@,
        @./Biped_autoclav.usda@,
        @./Biped_squetch.usda@,
        @./Biped_face_rig.usda@,
        @./Biped_body.usda@
    ]
    upAxis = "Y"
)

over "Biped"
{
    over "Rig"
    {
        over "Solvers"
        {
            token visibility = "invisible"
        }

        def RigExecControl "Main"
        {
            def RigExecControl "Shot"
            {
                def RigExecControl "Aux"
                {
                    over "Joints"
                    {
                        token visibility = "invisible"
                    }
                }
            }
        }
    }
}

