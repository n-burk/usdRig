#usda 1.0
(
    defaultPrim = "Biped"
    doc = "The head squetch and the neck slide: the clusters that squash and stretch the skull as the head wire is pulled, and the neck_shift control's two clusters. Adds prims and overrides nothing, so dropping this sublayer leaves the character exactly as it was."
)

