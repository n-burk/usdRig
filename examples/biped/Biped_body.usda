#usda 1.0
(
    defaultPrim = "Biped"
    doc = """The body, as one branch of the biped's layer tree. Each layer\r\r
    carries one kind of data for the body, strongest first:\r\r
\r\r
      Biped_body_picker.usda          the Body panel of the control picker\r\r
      Biped_body_touch_regions.usda   TouchPose regions on the body's\r\r
                                      controls\r\r
      Biped_body_breathing.usda       the chest and belly breathing dials\r\r
                                      and their pose interpolators\r\r
      Biped_body_psd.usda             the pose interpolators, one weight\r\r
                                      per body corrective\r\r
      Biped_body_shapes.usdc          the corrective blend shapes those\r\r
                                      weights drive\r\r
      Biped_body_bendy.usda           the bendy limbs: bend controls along\r\r
                                      each arm and leg and their wires\r\r
      Biped_body_wires.usda           the spine and head wires: three bend\r\r
                                      controls along the spine and three\r\r
                                      over the skull, and the wires they\r\r
                                      drive\r\r
      Biped_body_center.usda          the spine, neck, head and rig root\r\r
      Biped_body_left.usda            the left limbs\r\r
      Biped_body_right.usda           the right limbs\r\r
      Biped_body_model.usda           the geometry and materials\r\r
\r\r
    The face branch, Biped_face_rig.usda, has the same kinds of layer for\r\r
    the face. Mute a layer to switch it off; the psd and shapes layers go\r\r
    together."""
    metersPerUnit = 0.01
    subLayers = [
        @./Biped_body_psd_fixes.usda@,
        @./Biped_body_picker.usda@,
        @./Biped_body_touch_regions.usda@,
        @./Biped_body_breathing.usda@,
        @./Biped_body_psd.usda@,
        @./Biped_body_shapes.usdc@,
        @./Biped_body_bendy.usda@,
        @./Biped_body_wires.usda@,
        @./Biped_body_center.usda@,
        @./Biped_body_left.usda@,
        @./Biped_body_right.usda@,
        @./Biped_model_parts.usda@,
        @./Biped_body_model.usda@
    ]
    upAxis = "Y"
)

over "Biped"
{
    reorder nameChildren = ["Rig", "Geom", "Materials"]
    over "Rig"
    {
        reorder nameChildren = ["Joints", "Movers", "Controls", "Solvers"]
        over "Movers"
        {
            reorder nameChildren = ["param_follow", "bendy_geo", "skin_body_geo", "bodyWires_geo", "squetch_geo", "mouth_geo", "cheeks_geo", "brows_geo", "eyes_r_geo", "eyes_l_geo", "lashes_geo", "bendy_pose", "face_shapes_geo", "shapes_body_geo", "headwire_follow_pose", "jaw_drivers", "face_psd_drivers", "squetch_drivers", "breathing_drivers", "cheeks_drivers", "brows_drivers", "mouth_drivers", "eyes_l_drivers", "eyes_r_drivers", "pose_drivers", "twist_aims", "eyes_r_pose", "eyes_l_pose", "mouth_pose", "face_eyes", "eye_converge_drivers", "face_brow_joints", "face_inner_joints", "nose_bridge_compress_scale_w", "face_brow_pivots", "face_pivots", "nose_compress_w", "nose_bridge_compress_w", "nose_bridge_follow_w", "face_mid_compress_w", "teeth_tongue_drivers", "teeth_upper_drivers", "face_outer_joints", "eye_socket_follow_drivers", "bodyWires_pose", "neck_to_bind", "girdles", "spine_to_bind", "hips_follow", "leg_fk_ball_drivers", "ball_l_bind_scAim", "ankle_l_bind_scAim", "ballRoll_l_down_rc", "ballRoll_l_down_w", "ballRoll_l_up_rc", "ballRoll_l_up_w", "toe_l_roll_rc", "toe_l_roll_w", "heel_l_roll_rc", "heel_l_roll_w", "bankOut_l_pivot_rc", "bankOut_l_pivot_w", "bankIn_l_pivot_rc", "bankIn_l_pivot_w", "ball_r_bind_scAim", "ankle_r_bind_scAim", "ballRoll_r_down_rc", "ballRoll_r_down_w", "ballRoll_r_up_rc", "ballRoll_r_up_w", "toe_r_roll_rc", "toe_r_roll_w", "heel_r_roll_rc", "heel_r_roll_w", "bankOut_r_pivot_rc", "bankOut_r_pivot_w", "bankIn_r_pivot_rc", "bankIn_r_pivot_w", "hand_l_follow", "hand_r_follow", "spine_mid_follow", "foot_roll_total"]
            over "pose_drivers"
            {
                reorder nameChildren = ["elbow_l_driver_copies_elbow_l_bind", "elbow_r_driver_copies_elbow_r_bind", "wristSwing_l_driver_copies_wrist_l_bind", "wristSwing_r_driver_copies_wrist_r_bind", "shoulder_l_twist_driver_copies_shoulderNoTwist_l_bind", "shoulder_r_twist_driver_copies_shoulderNoTwist_r_bind", "wristTwist_l_driver_copies_wristTwist_l_bind", "wristTwist_r_driver_copies_wristTwist_r_bind", "shoulder_l_driver_copies_shoulder_l_bind", "shoulder_r_driver_copies_shoulder_r_bind", "ankleSwing_l_driver_copies_ankle_l_bind", "ankleSwing_r_driver_copies_ankle_r_bind", "knee_l_driver_copies_knee_l_bind", "knee_r_driver_copies_knee_r_bind", "toe_l_driver_copies_ball_l_bind", "toe_r_driver_copies_ball_r_bind", "ankleTwist_l_driver_copies_ankleTwist_l_bind", "ankleTwist_r_driver_copies_ankleTwist_r_bind", "thigh_l_twist_driver_copies_thighNoTwist_l_bind", "thigh_r_twist_driver_copies_thighNoTwist_r_bind", "thigh_l_driver_copies_thigh_l_bind", "thigh_r_driver_copies_thigh_r_bind"]
            }

            over "twist_aims"
            {
                reorder nameChildren = ["shoulderNoTwist_l_bind_aim", "shoulderNoTwist_r_bind_aim", "elbowTwist_l_bind_aim", "elbowTwist_r_bind_aim", "clavicle_trans_l_bind_aim", "clavicle_trans_r_bind_aim", "thighNoTwist_l_bind_aim", "thighNoTwist_r_bind_aim", "kneeTwist_l_bind_aim", "kneeTwist_r_bind_aim", "pelvis_trans_l_bind_aim", "pelvis_trans_r_bind_aim", "clavicle_trans_l_bind_follows_shoulder_l_bind", "clavicle_trans_r_bind_follows_shoulder_r_bind", "pelvis_trans_l_bind_follows_thigh_l_bind", "pelvis_trans_r_bind_follows_thigh_r_bind", "shoulderNoTwist_l_bind_follows_shoulder_l_bind", "shoulderNoTwist_r_bind_follows_shoulder_r_bind", "thighNoTwist_l_bind_follows_thigh_l_bind", "thighNoTwist_r_bind_follows_thigh_r_bind", "wristTwist_l_bind_follows_wrist_l_bind", "wristTwist_r_bind_follows_wrist_r_bind", "ankleTwist_l_bind_follows_ankle_l_bind", "ankleTwist_r_bind_follows_ankle_r_bind", "ankleTwist_l_bind_aim", "ankleTwist_l_bind_copy", "ankleTwist_r_bind_aim", "ankleTwist_r_bind_copy", "wristTwist_l_bind_aim", "wristTwist_l_bind_copy", "wristTwist_r_bind_aim", "wristTwist_r_bind_copy"]
            }

            over "neck_to_bind"
            {
                reorder nameChildren = ["neck_ik_skull_bind_to_skull_bind", "neck_ik_skull_bind_scale_to_skull_bind", "neck_ik_neck_3_bind_to_neck_3_bind", "neck_ik_neck_3_bind_scale_to_neck_3_bind", "neck_ik_neck_2_bind_to_neck_2_bind", "neck_ik_neck_2_bind_scale_to_neck_2_bind", "neck_ik_neck_1_bind_to_neck_1_bind", "neck_ik_neck_1_bind_scale_to_neck_1_bind", "neck_ik_neck_0_bind_to_neck_0_bind", "neck_ik_neck_0_bind_scale_to_neck_0_bind"]
            }

            over "girdles"
            {
                reorder nameChildren = ["clavicle_l_ctl_unsquashes_clavicle_l_bind", "clavicle_r_ctl_unsquashes_clavicle_r_bind", "spine_end_ctl_unsquashes_neck_base_bind", "clavicle_l_ctl_drives_clavicle_l_bind", "clavicle_r_ctl_drives_clavicle_r_bind", "pelvis_l_ctl_drives_pelvis_l_bind", "pelvis_r_ctl_drives_pelvis_r_bind", "spine_end_ctl_drives_chest_bind"]
            }

            over "spine_to_bind"
            {
                reorder nameChildren = ["spine_ik_chest_bind_to_chest_bind", "spine_ik_chest_bind_scale_to_chest_bind", "spine_ik_spine_5_bind_to_spine_5_bind", "spine_ik_spine_5_bind_scale_to_spine_5_bind", "spine_ik_spine_4_bind_to_spine_4_bind", "spine_ik_spine_4_bind_scale_to_spine_4_bind", "spine_ik_spine_3_bind_to_spine_3_bind", "spine_ik_spine_3_bind_scale_to_spine_3_bind", "spine_ik_spine_2_bind_to_spine_2_bind", "spine_ik_spine_2_bind_scale_to_spine_2_bind", "spine_ik_spine_1_bind_to_spine_1_bind", "spine_ik_spine_1_bind_scale_to_spine_1_bind", "spine_ik_spine_0_bind_to_spine_0_bind", "spine_ik_spine_0_bind_scale_to_spine_0_bind"]
            }

            over "hips_follow"
            {
                reorder nameChildren = ["spine_root_ctl_scales_hips_bind", "spine_root_ctl_drives_hips_bind"]
            }

            over "ballRoll_l_down_w"
            {
                reorder nameChildren = ["ballRoll_l_down_w_4_multiply", "ballRoll_l_down_w_3_clamp", "ballRoll_l_down_w_2_add", "ballRoll_l_down_w_1_multiply", "ballRoll_l_down_w_0_add"]
            }

            over "ballRoll_l_up_w"
            {
                reorder nameChildren = ["ballRoll_l_up_w_2_multiply", "ballRoll_l_up_w_1_clamp", "ballRoll_l_up_w_0_add"]
            }

            over "toe_l_roll_w"
            {
                reorder nameChildren = ["toe_l_roll_w_4_clamp", "toe_l_roll_w_3_multiply", "toe_l_roll_w_2_add", "toe_l_roll_w_1_multiply", "toe_l_roll_w_0_add"]
            }

            over "heel_l_roll_w"
            {
                reorder nameChildren = ["heel_l_roll_w_2_clamp", "heel_l_roll_w_1_multiply", "heel_l_roll_w_0_add"]
            }

            over "bankOut_l_pivot_w"
            {
                reorder nameChildren = ["bankOut_l_pivot_w_2_clamp", "bankOut_l_pivot_w_1_multiply", "bankOut_l_pivot_w_0_add"]
            }

            over "bankIn_l_pivot_w"
            {
                reorder nameChildren = ["bankIn_l_pivot_w_2_clamp", "bankIn_l_pivot_w_1_multiply", "bankIn_l_pivot_w_0_add"]
            }

            over "ballRoll_r_down_w"
            {
                reorder nameChildren = ["ballRoll_r_down_w_4_multiply", "ballRoll_r_down_w_3_clamp", "ballRoll_r_down_w_2_add", "ballRoll_r_down_w_1_multiply", "ballRoll_r_down_w_0_add"]
            }

            over "ballRoll_r_up_w"
            {
                reorder nameChildren = ["ballRoll_r_up_w_2_multiply", "ballRoll_r_up_w_1_clamp", "ballRoll_r_up_w_0_add"]
            }

            over "toe_r_roll_w"
            {
                reorder nameChildren = ["toe_r_roll_w_4_clamp", "toe_r_roll_w_3_multiply", "toe_r_roll_w_2_add", "toe_r_roll_w_1_multiply", "toe_r_roll_w_0_add"]
            }

            over "heel_r_roll_w"
            {
                reorder nameChildren = ["heel_r_roll_w_2_clamp", "heel_r_roll_w_1_multiply", "heel_r_roll_w_0_add"]
            }

            over "bankOut_r_pivot_w"
            {
                reorder nameChildren = ["bankOut_r_pivot_w_2_clamp", "bankOut_r_pivot_w_1_multiply", "bankOut_r_pivot_w_0_add"]
            }

            over "bankIn_r_pivot_w"
            {
                reorder nameChildren = ["bankIn_r_pivot_w_2_clamp", "bankIn_r_pivot_w_1_multiply", "bankIn_r_pivot_w_0_add"]
            }

            over "hand_l_follow"
            {
                reorder nameChildren = ["index_001_l_bind_fk_follow_to_wrist_l_bind", "middle_001_l_bind_fk_follow_to_wrist_l_bind", "pinkyCup_l_bind_fk_follow_to_wrist_l_bind", "ring_001_l_bind_fk_follow_to_wrist_l_bind", "thumbCup_l_bind_fk_follow_to_wrist_l_bind"]
            }

            over "hand_r_follow"
            {
                reorder nameChildren = ["index_001_r_bind_fk_follow_to_wrist_r_bind", "middle_001_r_bind_fk_follow_to_wrist_r_bind", "pinkyCup_r_bind_fk_follow_to_wrist_r_bind", "ring_001_r_bind_fk_follow_to_wrist_r_bind", "thumbCup_r_bind_fk_follow_to_wrist_r_bind"]
            }

            over "spine_mid_follow"
            {
                reorder nameChildren = ["spine_mid_follow_aim", "spine_mid_follow_pos"]
            }

            over "param_follow"
            {
                reorder nameChildren = ["arm_l_params_to_wrist_l_bind", "arm_r_params_to_wrist_r_bind", "leg_l_params_to_ankle_l_bind", "leg_r_params_to_ankle_r_bind"]
            }

            def Scope "leg_fk_ball_drivers"
            {
                reorder nameChildren = ["R_Ball_drives_ball_r_def", "L_Ball_drives_ball_l_def", "L_Ball_weight_2_add", "L_Ball_weight_1_multiply", "L_Ball_weight_0_blend", "R_Ball_weight_2_add", "R_Ball_weight_1_multiply", "R_Ball_weight_0_blend"]
                def RigExecRotationConstraint "L_Ball_drives_ball_l_def" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:defaultWeight = 0
                    double3 inputs:rotationOffset = (-0, 0, -0)
                    rel rigExec:moves = </Biped/Rig/Main/Shot/Aux/Joints/hips_def/pelvis_l_def/thigh_l_def/knee_l_def/ankle_l_def/ball_l_def>
                    rel rigExec:sources = </Biped/Rig/Main/Shot/Aux/Controls/M_Body/M_HipSwivel/M_BodyGimbal/L_Hip/L_UpLegSwing/L_UpLeg/L_LoLeg/L_Foot/L_Ball>
                }

                def RigExecFloatMathMover "L_Ball_weight_2_add" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:value = 1
                    rel rigExec:moves = </Biped/Rig/Movers/leg_fk_ball_drivers/L_Ball_drives_ball_l_def.inputs:defaultWeight>
                    uniform token rigExec:operation = "add"
                }

                def RigExecFloatMathMover "L_Ball_weight_1_multiply" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:value = -1
                    rel rigExec:moves = </Biped/Rig/Movers/leg_fk_ball_drivers/L_Ball_drives_ball_l_def.inputs:defaultWeight>
                    uniform token rigExec:operation = "multiply"
                }

                def RigExecFloatMathMover "L_Ball_weight_0_blend" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:value.connect = </Biped/Rig/Main/Shot/Aux/Controls/L_Leg.avars:ikfk>
                    rel rigExec:moves = </Biped/Rig/Movers/leg_fk_ball_drivers/L_Ball_drives_ball_l_def.inputs:defaultWeight>
                    uniform token rigExec:operation = "blend"
                }

                def RigExecRotationConstraint "R_Ball_drives_ball_r_def" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:defaultWeight = 0
                    double3 inputs:rotationOffset = (-0, 0, -0)
                    rel rigExec:moves = </Biped/Rig/Main/Shot/Aux/Joints/hips_def/pelvis_r_def/thigh_r_def/knee_r_def/ankle_r_def/ball_r_def>
                    rel rigExec:sources = </Biped/Rig/Main/Shot/Aux/Controls/M_Body/M_HipSwivel/M_BodyGimbal/R_Hip/R_UpLegSwing/R_UpLeg/R_LoLeg/R_Foot/R_Ball>
                }

                def RigExecFloatMathMover "R_Ball_weight_2_add" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:value = 1
                    rel rigExec:moves = </Biped/Rig/Movers/leg_fk_ball_drivers/R_Ball_drives_ball_r_def.inputs:defaultWeight>
                    uniform token rigExec:operation = "add"
                }

                def RigExecFloatMathMover "R_Ball_weight_1_multiply" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:value = -1
                    rel rigExec:moves = </Biped/Rig/Movers/leg_fk_ball_drivers/R_Ball_drives_ball_r_def.inputs:defaultWeight>
                    uniform token rigExec:operation = "multiply"
                }

                def RigExecFloatMathMover "R_Ball_weight_0_blend" (
                    apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:value.connect = </Biped/Rig/Main/Shot/Aux/Controls/R_Leg.avars:ikfk>
                    rel rigExec:moves = </Biped/Rig/Movers/leg_fk_ball_drivers/R_Ball_drives_ball_r_def.inputs:defaultWeight>
                    uniform token rigExec:operation = "blend"
                }
            }
        }

        over "Solvers"
        {
            reorder nameChildren = ["spine_splineIk", "neck_splineIk", "fk_index_l", "fk_middle_l", "fk_pinky_l", "fk_ring_l", "fk_thumb_l", "fk_index_r", "fk_middle_r", "fk_pinky_r", "fk_ring_r", "fk_thumb_r", "arm_l_twoBoneIk", "arm_l_fkChain", "arm_l_ikfk", "arm_r_twoBoneIk", "arm_r_fkChain", "arm_r_ikfk", "leg_l_twoBoneIk", "leg_l_fkChain", "leg_l_ikfk", "leg_r_twoBoneIk", "leg_r_fkChain", "leg_r_ikfk"]
        }

        def RigExecControl "Main"
        {
            color3f guide:displayColor = (1, 1, 0.25)
            double guide:scaleX = 93.3
            double guide:scaleY = 93.3
            double guide:scaleZ = 93.3
            uniform token guide:shape = "circle"

            def RigExecControl "Shot"
            {
                color3f guide:displayColor = (0.25, 0.85, 1)
                double guide:scaleX = 45.6
                double guide:scaleY = 45.6
                double guide:scaleZ = 45.6
                uniform token guide:shape = "circle"

                def RigExecControl "Aux"
                {
                    color3f guide:displayColor = (1, 0.65, 0.15)
                    double guide:scaleX = 41.1
                    double guide:scaleY = 41.1
                    double guide:scaleZ = 41.1
                    uniform token guide:shape = "circle"

                    over "Controls"
                    {
                        reorder nameChildren = ["hips_ctl", "spine_mid_follow", "arm_l_ik", "arm_l_pv", "arm_r_ik", "arm_r_pv", "leg_l_ik", "leg_l_pv", "leg_r_ik", "leg_r_pv", "index_001_l_bind_fk_follow", "middle_001_l_bind_fk_follow", "pinkyCup_l_bind_fk_follow", "ring_001_l_bind_fk_follow", "thumbCup_l_bind_fk_follow", "index_001_r_bind_fk_follow", "middle_001_r_bind_fk_follow", "pinkyCup_r_bind_fk_follow", "ring_001_r_bind_fk_follow", "thumbCup_r_bind_fk_follow", "arm_l_params", "arm_r_params", "leg_l_params", "leg_r_params"]
                        over "L_LegIK"
                        {
                            custom double avars:space = 0

                            over "ankle_l_pivot"
                            {
                                reorder nameChildren = ["bank_l", "bankIn_l_pivot", "bankIn_l_pivot_twin"]
                                over "bankIn_l_pivot"
                                {
                                    reorder nameChildren = ["bankOut_l_pivot", "bankOut_l_pivot_twin"]
                                    over "bankOut_l_pivot"
                                    {
                                        reorder nameChildren = ["heel_l_roll", "heel_l_roll_twin"]
                                        over "heel_l_roll"
                                        {
                                            over "L_Heel"
                                            {
                                                over "ball_l_pivot"
                                                {
                                                    reorder nameChildren = ["toe_l_roll", "toe_l_roll_twin"]
                                                    over "toe_l_roll"
                                                    {
                                                        over "L_Toe"
                                                        {
                                                            reorder nameChildren = ["ballRoll_l_up", "ballRoll_l_up_twin", "toeBend_l"]
                                                            over "ballRoll_l_up"
                                                            {
                                                                reorder nameChildren = ["ballRoll_l_down", "ballRoll_l_down_twin"]
                                                                over "ballRoll_l_down"
                                                                {
                                                                    over "L_BallRoll"
                                                                    {
                                                                        reorder nameChildren = ["ankle_l_ikTarget", "ball_l_ikTarget"]
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        over "R_LegIK"
                        {
                            custom double avars:space = 0

                            over "ankle_r_pivot"
                            {
                                reorder nameChildren = ["bank_r", "bankIn_r_pivot", "bankIn_r_pivot_twin"]
                                over "bankIn_r_pivot"
                                {
                                    reorder nameChildren = ["bankOut_r_pivot", "bankOut_r_pivot_twin"]
                                    over "bankOut_r_pivot"
                                    {
                                        reorder nameChildren = ["heel_r_roll", "heel_r_roll_twin"]
                                        over "heel_r_roll"
                                        {
                                            over "R_Heel"
                                            {
                                                over "ball_r_pivot"
                                                {
                                                    reorder nameChildren = ["toe_r_roll", "toe_r_roll_twin"]
                                                    over "toe_r_roll"
                                                    {
                                                        over "R_Toe"
                                                        {
                                                            reorder nameChildren = ["ballRoll_r_up", "ballRoll_r_up_twin", "toeBend_r"]
                                                            over "ballRoll_r_up"
                                                            {
                                                                reorder nameChildren = ["ballRoll_r_down", "ballRoll_r_down_twin"]
                                                                over "ballRoll_r_down"
                                                                {
                                                                    over "R_BallRoll"
                                                                    {
                                                                        reorder nameChildren = ["ankle_r_ikTarget", "ball_r_ikTarget"]
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        over "M_Body"
                        {
                            reorder nameChildren = ["torso_ctl", "spine_root_pivot"]
                            over "M_Torso"
                            {
                                over "M_Chest"
                                {
                                    over "M_ChestTop"
                                    {
                                        reorder nameChildren = ["neck_root_ctl", "clavicle_l_ctl", "clavicle_r_ctl"]
                                        uniform token guide:shape = "circle"

                                        over "M_Neck"
                                        {
                                            reorder nameChildren = ["neck_end_pivot", "neck_cv1"]
                                            custom double avars:space = 0
                                        }
                                    }
                                }
                            }

                            over "M_HipSwivel"
                            {
                                over "M_BodyGimbal"
                                {
                                    reorder nameChildren = ["pelvis_l_ctl", "pelvis_r_ctl"]
