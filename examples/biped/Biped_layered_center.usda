                rel rigExec:endControl = </Biped/Rig/Controls/hips_ctl/torso_ctl/spine_end_pivot/spine_end_ctl>
                rel rigExec:joints = [
                    </Biped/Rig/Joints/spine_ik_spine_0_bind>,
                    </Biped/Rig/Joints/spine_ik_spine_0_bind/spine_ik_spine_1_bind>,
