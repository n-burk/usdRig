#usda 1.0
(
    defaultPrim = "Biped"
    doc = "The face, as one layer over the rig it belongs to: controls for the jaw group, the mid-face and the nose, the pivots that carry the jaw compression and the nose's space blend, and the eye look-ats. Adds prims and overrides nothing, so dropping this sublayer leaves the character exactly as it was."
)

over "Biped"
{
