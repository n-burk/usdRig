            def Scope "bendy_geo"
            {
                reorder nameChildren = ["leg_r_curve_wire", "leg_l_curve_wire", "arm_r_curve_wire", "arm_l_curve_wire", "spine_curve_wire"]
                def RigExecCurveMover "arm_l_curve_wire" (
                    prepend apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    float inputs:dropoffDistance = 100
                    rel rigExec:bindCoordinates = </Biped/Rig/Weights/bendy/arm_l_curve_wire_bind.rigExec:bindCoordinates>
                    rel rigExec:driverCurve = </Biped/Rig/Curves/arm_l_curve>
                    uniform token rigExec:driverDeltaFrame = "posed"
                    rel rigExec:driverTransforms = [
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_0_l_follow/arm_bend_0_l_cst/L_ArmBend0>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_1_l_follow/arm_bend_1_l_cst/L_ArmBend1>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_2_l_follow/arm_bend_2_l_cst/L_ArmBend2>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_3_l_follow/arm_bend_3_l_cst/L_ArmBend3>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_4_l_follow/arm_bend_4_l_cst/L_ArmBend4>,
                    ]
                    rel rigExec:driverTransformSpaces = [
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_0_l_follow>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_1_l_follow>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_2_l_follow>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_3_l_follow>,
                        </Biped/Rig/Main/Shot/Aux/Controls/arm_bend_4_l_follow>,
                    ]
                    uniform token rigExec:mode = "wire"
                    rel rigExec:moves = </Biped/Geom/body_geo.points>
                    uniform token rigExec:pointFrame = "posed"
                    rel rigExec:space
                    uniform token rigExec:transformReadPhase = "final"
                    rel rigExec:weightObject = </Biped/Rig/Weights/bendy/arm_l_curve_wire>
                }

