        over "Controls"
        {
            over "hips_ctl"
            {
                over "torso_ctl"
                {
                    over "spine_end_pivot"
                    {
                        over "spine_end_ctl"
                        {
                            over "neck_root_ctl"
                            {
                                over "neck_end_pivot"
                                {
                                    over "neck_end_ctl"
                                    {
                                        over "skull_follow"
                                        {
                                            over "skull_ctl"
                                            {
                                                over "face_lower_ctl"
                                                {
                                                    over "jaw_ctl"
                                                    {
                                                        custom double avars:earFollow = 1 (
                                                            customData = {
                                                                dictionary limits = {
                                                                    double max = 1
                                                                    double min = 0
                                                                }
                                                            }
                                                            doc = "How much the ears follow the jaw."
                                                        )

                                                        def RigExecControl "chin_auto" (
                                                            prepend apiSchemas = ["RigExecControlAPI"]
                                                        )
                                                        {
                                                            double guide:scaleX = 0
                                                            double guide:scaleY = 0
                                                            double guide:scaleZ = 0
                                                            uniform token purpose = "default"
                                                            matrix4d rest:space = ( (0.9999999999999982, -4.417472613038524e-9, 7.262911686958621e-10, 0), (-4.417408164592831e-9, 0.9999999999998579, -4.281041289433954e-9, 0), (7.262959752798423e-10, -4.280906313202441e-9, 0.9999999999999971, 0), (2.1465936559112282e-8, -5.149599963151616, -7.914199973138153, 1) )

                                                            def RigExecControl "chin_ctl" (
                                                                prepend apiSchemas = ["RigExecControlAPI"]
                                                            )
                                                            {
                                                                color3f guide:displayColor = (0, 0, 1)
                                                                double guide:scaleX = 0.4082
                                                                double guide:scaleY = 0.3982
                                                                double guide:scaleZ = 0.39364999999999983
                                                                uniform token guide:shape = "box"
                                                                uniform token purpose = "default"
                                                                matrix4d rest:space = ( (1, 8.271804892935113e-25, 2.396877193094818e-25, 0), (1.2336573761827792e-31, 1, 8.67361737988453e-19, 0), (-1.3629021669606323e-25, 1.387778780781448e-17, 1, 0), (1.7341985901747728e-22, 2.842170943040401e-14, 0, 1) )
                                                            }
                                                        }
                                                    }

                                                    over "mouth_corner_l_follow"
                                                    {
                                                        over "mouth_corner_l_pin"
                                                        {
                                                            over "mouth_corner_l_ctl"
                                                            {
                                                                custom double avars:earFollow = 1 (
                                                                    customData = {
                                                                        dictionary limits = {
                                                                            double max = 1
                                                                            double min = 0
                                                                        }
                                                                    }
                                                                    doc = "How much the ear follows this mouth corner."
                                                                )
                                                                custom float face:earDistance = 1 (
                                                                    doc = "The corner's distance from ear over its rest distance, to first order."
                                                                )
                                                                custom float face:earDistance_x = 0
                                                                custom float face:earDistance_y = 0
                                                                custom float face:earDistance_z = 0
                                                                custom float face:eyeDistance = 1 (
                                                                    doc = "The corner's distance from eye over its rest distance, to first order."
                                                                )
                                                                custom float face:eyeDistance_x = 0
                                                                custom float face:eyeDistance_y = 0
                                                                custom float face:eyeDistance_z = 0
                                                            }
                                                        }
                                                    }

