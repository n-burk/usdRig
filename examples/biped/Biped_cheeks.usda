                                                            prepend apiSchemas = ["RigExecControlAPI"]
                                                        )
                                                        {
                                                            double guide:scaleX = 0
                                                            double guide:scaleY = 0
                                                            double guide:scaleZ = 0
                                                            uniform token purpose = "default"
                                                            matrix4d rest:space = ( (-0.6427876091301625, -4.3986783161531965e-10, 0.7660444426521229, 0), (-4.417408164592801e-9, 0.9999999999998295, -4.2810377358528235e-9, 0), (-0.7660444435858302, 6.135693884761218e-9, -0.6427876102429139, 0), (-2.0629000042918184, 1.1393000333706311, -4.973300001669081, 1) )

                                                            def RigExecControl "cheekPuff_l_ctl" (
