#usda 1.0
(
    # Biped_anim.usda's 200-frame overlay, over the WHOLE stack rather
    # than the flat rig: the same six controls keyed on avars:rz and
    # avars:ty over frames 1-200, composed over Biped_stack.usda, so the
    # animation drives the LAYERED rig with its correctives, touch
    # regions and picker on. A static stage never re-reads a time sample,
    # so this is what makes the stack exercise -- and time -- the animated
    # evaluate path.
    #
    # This file differs from Biped_anim.usda in one line, the sublayer;
    # keep the keys in step with it.
    endTimeCode = 200
    startTimeCode = 1
    subLayers = [
        @./Biped_stack.usda@
    ]
    timeCodesPerSecond = 24
)

