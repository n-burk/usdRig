// ------------------------------------------------ eye look inputs ---
// The iris and pupil as Shader inputs, each falling back to the
// literal the generator baked. Storm declares HD_HAS_<name> for an
// input the material actually carries, so a material that declares
// none of these is byte-for-byte the generated behaviour.

// ---------------------------------------------------------------------
// The rig's shape dials.
//
// The rig publishes them packed into one constant matrix primvar rather
// than as eight floats: a matrix primvar is a road that already exists
// (the projector's frame travels it) and one dirty flag per frame beats
// eight. Slot i is row i/4, column i%4, in the order the projector's
// rigExec:shaderDialSources lists them -- which
// tools/biped/eye_shape_avars.py writes in exactly this order:
//
//   0 pupilX   1 pupilY   2 irisX        3 irisY
//   4 pupilTX  5 pupilTY  6 pupilRadius  7 irisRadius
//
// ZERO IS NEUTRAL on every one, so an unbound primvar (all zeros) leaves
// the model's own value untouched, which is what makes this safe to ship
// switched on. Sizes MULTIPLY -- the rig is a factor on top of what the
// model says -- and the two pupil offsets ADD, because an offset's
// neutral can only be zero.
float ecDial(int slot)
{
#if defined(HD_HAS_eyeDials)
    mat4 dials = mat4(HdGet_eyeDials());
    return dials[slot / 4][slot % 4];
#else
    return 0.0;
#endif
}

float ecDialScale(float baked, int slot) { return baked * (1.0 + ecDial(slot)); }
float ecDialOffset(float baked, int slot) { return baked + ecDial(slot); }

float ecInput_pupilRadius(float baked)
{
#if defined(HD_HAS_pupilRadius)
    // The dial multiplies whatever base is in force. The material
    // binds this parameter, so HD_HAS_ is ALWAYS defined and the
    // #else below is dead -- putting the dial only there is why
    // turning one did nothing.
    return ecDialScale(HdGet_pupilRadius(), 6);
#else
    return ecDialScale(baked, 6);
#endif
}

