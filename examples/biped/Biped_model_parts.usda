    def "Materials"
    {
        def Material "eye_sbe"
        {
            token outputs:glslfx:surface.connect = </Biped/Materials/eye_sbe/Surface.outputs:surface>
            token outputs:surface.connect = </Biped/Materials/eye_sbe/Surface.outputs:surface>

            def Shader "Surface"
            {
                custom asset info:glslfx:sourceAsset = @./shaders/sbe_eye.glslfx@
                uniform token info:implementationSource = "sourceAsset"
                float inputs:irisHeight = 1
                float inputs:irisRadius = 0.4875
                float inputs:irisWidth = 1
                float inputs:pupilBleedAmount = 0.08
                float inputs:pupilHeight = 1
                float inputs:pupilRadius = 0.1667
                float inputs:pupilWidth = 1
                token outputs:surface
            }
        }
    }

