                                    {
                                        reorder nameChildren = ["toe_r_roll", "toe_r_roll_twin"]
                                        over "toe_r_roll"
                                        {
                                            over "toe_r"
                                            {
                                                reorder nameChildren = ["ballRoll_r_up", "ballRoll_r_up_twin", "toeBend_r"]
                                                over "ballRoll_r_up"
                                                {
                                                    reorder nameChildren = ["ballRoll_r_down", "ballRoll_r_down_twin"]
                                                    over "ballRoll_r_down"
                                                    {
                                                        over "ballRoll_r"
                                                        {
                                                            reorder nameChildren = ["ankle_r_ikTarget", "ball_r_ikTarget"]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
