                                            {
                                                reorder nameChildren = ["ballRoll_l_up", "ballRoll_l_up_twin", "toeBend_l"]
                                                over "ballRoll_l_up"
                                                {
                                                    reorder nameChildren = ["ballRoll_l_down", "ballRoll_l_down_twin"]
                                                    over "ballRoll_l_down"
                                                    {
                                                        over "ballRoll_l"
                                                        {
                                                            reorder nameChildren = ["ankle_l_ikTarget", "ball_l_ikTarget"]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            over "leg_r_ik"
            {
                over "ankle_r_pivot"
                {
                    reorder nameChildren = ["bank_r", "bankIn_r_pivot", "bankIn_r_pivot_twin"]
                    over "bankIn_r_pivot"
                    {
                        reorder nameChildren = ["bankOut_r_pivot", "bankOut_r_pivot_twin"]
                        over "bankOut_r_pivot"
                        {
