        def RigExecControl "Main"
        {
            def RigExecControl "Shot"
            {
                def RigExecControl "Aux"
                {
                    over "Controls"
                    {
                        over "M_Body"
                        {
                            over "M_Torso"
                            {
                                over "M_Chest"
                                {
                                    over "M_ChestTop"
                                    {
                                        custom double avars:breathing:belly = 0 (
                                            customData = {
                                                dictionary limits = {
                                                    dictionary hard = {
                                                        double maximum = 100
                                                        double minimum = -100
                                                    }
                                                    dictionary soft = {
                                                        double maximum = 10
                                                        double minimum = -10
                                                    }
                                                }
                                            }
                                            doc = "Breathe with the belly: positive breathes in, negative out. The belly breath shapes sit at +-10 and +-100."
                                        )
                                        custom double avars:breathing:chest = 0 (
                                            customData = {
                                                dictionary limits = {
                                                    dictionary hard = {
                                                        double maximum = 100
                                                        double minimum = -100
                                                    }
                                                    dictionary soft = {
                                                        double maximum = 10
                                                        double minimum = -10
                                                    }
                                                }
                                            }
                                            doc = "Breathe with the chest: positive breathes out, negative in. The chest breath shapes sit at +-10 and +-100."
                                        )
                                        custom double avars:breathing:shoulders = 0 (
                                            customData = {
                                                dictionary limits = {
                                                    dictionary hard = {
                                                        double maximum = 100
                                                        double minimum = -100
                                                    }
                                                    dictionary soft = {
                                                        double maximum = 10
                                                        double minimum = -10
                                                    }
                                                }
                                            }
                                            doc = "Breathe with the shoulders: they slide out and forward as the chest fills. The source rig's keys reach their full slide at 10."
                                        )
                                        custom token guide:shape = "circle"

                                        def RigExecControl "breathing_drivers" (
                                            prepend apiSchemas = ["RigExecControlAPI"]
                                        )
                                        {
                                            double guide:scaleX = 0
                                            double guide:scaleY = 0
                                            double guide:scaleZ = 0
                                            uniform token purpose = "default"
                                            matrix4d rest:space = ( (1, 0, 1.8488927466117445e-32, 0), (1.232595164407831e-32, 1, -2.465190328815662e-32, 0), (1.8488927466117467e-32, 2.465190328815662e-32, 1, 0), (0, 0, 0, 1) )
                                        }

                                        over "L_Shldr"
                                        {
                                            custom token guide:shape = "circle"

                                            over "L_UpArmSwing"
                                            {
                                                def RigExecControl "arm_l_root_breath_tx" (
