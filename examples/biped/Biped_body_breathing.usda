#usda 1.0
(
    defaultPrim = "Biped"
    doc = "Breathing: the chest and belly dials on the chest control and the two pose interpolators they drive, wired to the body's breath shapes. Adds prims and overrides nothing, so dropping this sublayer leaves the character exactly as it was."
)

over "Biped"
{
    over "Rig"
    {
        over "PoseInterpolators"
        {
            def RigExecPoseInterpolator "breathing_chest" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                bool inputs:enabled = 1
                bool rigExec:allowNegativeWeights = 1
                rel rigExec:driver = None
                rel rigExec:driverAttributes = </Biped/Rig/Main/Shot/Aux/Controls/M_Body/M_Torso/M_Chest/M_ChestTop.avars:breathing:chest>
                bool rigExec:enableRotation = 0
                bool rigExec:enableTranslation = 1
                uniform token rigExec:kernel = "linear"
                bool rigExec:normalize = 1
                float rigExec:regularization = 0
                uniform token rigExec:twistAxis = "X"

                def RigExecPose "neutral" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    bool inputs:enabled = 1
                    float outputs:weight = 0
                    float rigExec:falloff = 0.3
                    rel rigExec:poseControls = [
                        </Biped/Rig/Main/Shot/Aux/Controls/M_Body/M_Torso/M_Chest/M_ChestTop.avars:breathing:chest>,
                        </Biped/Rig/Main/Shot/Aux/Controls/M_Body/M_Torso/M_Chest/M_ChestTop.avars:breathing:belly>,
                    ]
                    double[] rigExec:poseControlValues = [0, 0]
                    uniform token rigExec:poseType = "swing"
                    quatf rigExec:rotation = (1, 0, 0, 0)
                    float rigExec:rotationRadius = 1.5707964
                    float3 rigExec:translation = (0, 0, 0)
                    float rigExec:translationRadius = 216
                }

