                def Scope "Body"
                {
                    reorder nameChildren = ["BodyWarp", "Lean"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Kaede/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Kaede/Geom/Body.points>
                    }

                    def RigExecMatrixMover "Lean" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:moves = </Kaede/Geom/Body.points>
                        rel rigExec:transform = </Kaede/Rig/Joints/Body> (
                            rigExecReadPhase = "final"
                        )
                    }
                }

                def Scope "Collar"
                {
                    reorder nameChildren = ["BodyWarp", "Lean"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Kaede/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Kaede/Geom/Collar.points>
                    }

                    def RigExecMatrixMover "Lean" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:moves = </Kaede/Geom/Collar.points>
                        rel rigExec:transform = </Kaede/Rig/Joints/Body> (
                            rigExecReadPhase = "final"
                        )
                    }
                }

                def Scope "Ribbon"
                {
                    reorder nameChildren = ["BodyWarp", "RibbonSkin"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Kaede/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Kaede/Geom/Ribbon.points>
                    }

                    def RigExecSkinMover "RibbonSkin" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform int rigExec:elementSize = 3
                        rel rigExec:influences = [
                            </Kaede/Rig/Joints/Body>,
                            </Kaede/Rig/Joints/Accessories/Ribbon_TailL_0>,
                            </Kaede/Rig/Joints/Accessories/Ribbon_TailL_0/Ribbon_TailL_1>,
