                }

                def Scope "Neck"
                {
                    reorder nameChildren = ["BodyWarp", "HeadWarp", "SpineSkin"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Kaede/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Kaede/Geom/Neck.points>
                    }

                    def RigExecLatticeMover "HeadWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Kaede/Cages/HeadCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (7, 9, 2)
                        rel rigExec:moves = </Kaede/Geom/Neck.points>
                    }

                    def RigExecSkinMover "SpineSkin" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform int rigExec:elementSize = 3
                        rel rigExec:influences = [
                            </Kaede/Rig/Joints/Body>,
                            </Kaede/Rig/Joints/Body/Neck>,
                            </Kaede/Rig/Joints/Body/Neck/Head>,
                        ] (
