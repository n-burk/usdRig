#usda 1.0
(
    doc = "Shot dressing for the Shion bust shots: a flat graphic backdrop card behind the character (not part of the rig). Generated by build_bust.py."
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Backdrop"
{
    def Mesh "Card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-50, -62, -9), (50, 22, -9)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </Backdrop/Look>
        point3f[] points = [(-50, -62, -9), (50, -62, -9), (50, 22, -9), (-50, 22, -9)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }

    def Material "Look"
    {
        token outputs:surface.connect = </Backdrop/Look/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Backdrop/Look/Texture.outputs:rgb>
            float inputs:roughness = 1
            color3f inputs:specularColor = (0, 0, 0)
            int inputs:useSpecularWorkflow = 1
            token outputs:surface
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Texture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/Backdrop.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Backdrop/Look/UV.outputs:result>
            float3 outputs:rgb
        }
    }
}
