                def Scope "Face"
                {
                    reorder nameChildren = ["HeadTilt", "TurnRefine", "HeadWarp", "Keyforms"]
                    def RigExecBlendShapeMover "Keyforms" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:blendInputs = [
                            </Shion/Rig/BlendInputs/Face/Open>,
                            </Shion/Rig/BlendInputs/Face/Wide>,
                            </Shion/Rig/BlendInputs/Face/Round>,
                            </Shion/Rig/BlendInputs/Face/Smile>,
                            </Shion/Rig/BlendInputs/Face/Frown>,
                            </Shion/Rig/BlendInputs/Face/OpenWide>,
                            </Shion/Rig/BlendInputs/Face/OpenRound>,
                            </Shion/Rig/BlendInputs/Face/OpenSmile>,
                            </Shion/Rig/BlendInputs/Face/OpenFrown>,
                            </Shion/Rig/BlendInputs/Face/BlushPop>,
                            </Shion/Rig/BlendInputs/Face/Sweat>,
                            </Shion/Rig/BlendInputs/Face/Hatch>,
                        ]
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Face>
                    }

                    def RigExecLatticeMover "HeadWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/HeadCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 7, 3)
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Face>
                    }

                    def RigExecBlendShapeMover "TurnRefine" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:blendInputs = [
                            </Shion/Rig/BlendInputs/Face/Turn_R>,
                            </Shion/Rig/BlendInputs/Face/Turn_L>,
                            </Shion/Rig/BlendInputs/Face/Nod_Down>,
                            </Shion/Rig/BlendInputs/Face/Nod_Up>,
                        ]
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Face>
                    }

                    def RigExecMatrixMover "HeadTilt" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:transform = </Shion/Rig/Joints/Body/Neck/Head> (
                            rigExecReadPhase = "final"
                        )
                        rel rigExec:weightObject = </Shion/Rig/Weights/Face>
                    }
                }

                def Scope "Earring"
                {
                    reorder nameChildren = ["HairSkin", "TurnRefine", "HeadWarp"]
                    def RigExecLatticeMover "HeadWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/HeadCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 7, 3)
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Earring>
                    }

                    def RigExecBlendShapeMover "TurnRefine" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:blendInputs = [
                            </Shion/Rig/BlendInputs/Earring/Turn_R>,
                            </Shion/Rig/BlendInputs/Earring/Turn_L>,
                            </Shion/Rig/BlendInputs/Earring/Nod_Down>,
                            </Shion/Rig/BlendInputs/Earring/Nod_Up>,
                        ]
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Earring>
                    }

                    def RigExecSkinMover "HairSkin" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform int rigExec:elementSize = 4
                        rel rigExec:influences = [
                            </Shion/Rig/Joints/Body/Neck/Head>,
                            </Shion/Rig/Joints/Hair/Earring_0>,
                            </Shion/Rig/Joints/Hair/Earring_0/Earring_1>,
                        ] (
