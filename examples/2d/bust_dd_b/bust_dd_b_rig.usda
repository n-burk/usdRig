                def Scope "HeadLatticeWire"
                {
                    reorder nameChildren = ["Follow", "Warp"]
                    def RigExecLatticeMover "Warp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/HeadCage> (
                            rigExecReadPhase = "final"
                        )
                        uniform token rigExec:cageReadPhase = "final"
                        int3 rigExec:divisions = (6, 7, 3)
                        rel rigExec:moves = </Shion/Rig/Guides/HeadLatticeWire.points>
                    }

                    def RigExecMatrixMover "Follow" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:moves = </Shion/Rig/Guides/HeadLatticeWire.points>
                        rel rigExec:transform = </Shion/Rig/Joints/Body/Neck/Head>
                        uniform token rigExec:transformReadPhase = "final"
                    }
                }

                def Scope "BodyLatticeWire"
                {
                    reorder nameChildren = ["Follow", "Warp"]
                    def RigExecLatticeMover "Warp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        uniform token rigExec:cageReadPhase = "final"
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Shion/Rig/Guides/BodyLatticeWire.points>
                    }

                    def RigExecMatrixMover "Follow" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:moves = </Shion/Rig/Guides/BodyLatticeWire.points>
                        rel rigExec:transform = </Shion/Rig/Joints/Body>
                        uniform token rigExec:transformReadPhase = "final"
                    }
                }
            }

            def Scope "Cages"
            {
                def RigExecBlendShapeMover "HeadCageKeyforms" (
                    prepend apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    rel rigExec:blendInputs = [
                        </Shion/Rig/BlendInputs/HeadCage/Turn_R>,
                        </Shion/Rig/BlendInputs/HeadCage/Turn_L>,
                        </Shion/Rig/BlendInputs/HeadCage/Nod_Down>,
                        </Shion/Rig/BlendInputs/HeadCage/Nod_Up>,
                    ]
                    rel rigExec:moves = </Shion/Cages/HeadCage.points>
                }

                def RigExecBlendShapeMover "BodyCageKeyforms" (
                    prepend apiSchemas = ["RigExecMoverAPI"]
                )
                {
                    rel rigExec:blendInputs = [
                        </Shion/Rig/BlendInputs/BodyCage/Breath>,
                        </Shion/Rig/BlendInputs/BodyCage/BodyTurn_R>,
                        </Shion/Rig/BlendInputs/BodyCage/BodyTurn_L>,
                    ]
                    rel rigExec:moves = </Shion/Cages/BodyCage.points>
                }
            }
        }
    }

