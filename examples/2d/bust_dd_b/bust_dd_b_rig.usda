            def Scope "Geometry"
            {
                reorder nameChildren = ["BackHair", "Body", "Ribbon", "Neck", "Face", "Earring", "Eye_R", "Eye_L", "Mouth", "Brow_R", "Brow_L", "Hair", "Arm_L", "Hand_L", "Arm_R", "Hand_R", "HeadLatticeWire", "BodyLatticeWire"]
                def Scope "BackHair"
                {
                    reorder nameChildren = ["HairSkin", "TurnRefine", "HeadWarp"]
                    def RigExecLatticeMover "HeadWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/HeadCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 7, 3)
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/BackHair>
                    }

                    def RigExecBlendShapeMover "TurnRefine" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:blendInputs = [
                            </Shion/Rig/BlendInputs/BackHair/Turn_R>,
                            </Shion/Rig/BlendInputs/BackHair/Turn_L>,
                            </Shion/Rig/BlendInputs/BackHair/Nod_Down>,
                            </Shion/Rig/BlendInputs/BackHair/Nod_Up>,
                        ]
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/BackHair>
                    }

                    def RigExecSkinMover "HairSkin" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform int rigExec:elementSize = 4
                        rel rigExec:influences = [
                            </Shion/Rig/Joints/Body/Neck/Head>,
                            </Shion/Rig/Joints/Hair/BackL_0>,
                            </Shion/Rig/Joints/Hair/BackL_0/BackL_1>,
                            </Shion/Rig/Joints/Hair/BackL_0/BackL_1/BackL_2>,
                            </Shion/Rig/Joints/Hair/BackL_0/BackL_1/BackL_2/BackL_3>,
                            </Shion/Rig/Joints/Hair/BackR_0>,
                            </Shion/Rig/Joints/Hair/BackR_0/BackR_1>,
                            </Shion/Rig/Joints/Hair/BackR_0/BackR_1/BackR_2>,
                            </Shion/Rig/Joints/Hair/BackR_0/BackR_1/BackR_2/BackR_3>,
                        ] (
