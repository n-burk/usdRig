                def Scope "Body"
                {
                    reorder nameChildren = ["Lean", "BodyWarp"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Body>
                    }

                    def RigExecMatrixMover "Lean" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:transform = </Shion/Rig/Joints/Body> (
                            rigExecReadPhase = "final"
                        )
                        rel rigExec:weightObject = </Shion/Rig/Weights/Body>
                    }
                }

                def Scope "Ribbon"
                {
                    reorder nameChildren = ["RibbonSkin", "BodyWarp"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Ribbon>
                    }

                    def RigExecSkinMover "RibbonSkin" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform int rigExec:elementSize = 3
                        rel rigExec:influences = [
                            </Shion/Rig/Joints/Body>,
                            </Shion/Rig/Joints/Ribbon/TailL_0>,
                            </Shion/Rig/Joints/Ribbon/TailL_0/TailL_1>,
                            </Shion/Rig/Joints/Ribbon/TailL_0/TailL_1/TailL_2>,
                            </Shion/Rig/Joints/Ribbon/TailR_0>,
                            </Shion/Rig/Joints/Ribbon/TailR_0/TailR_1>,
                            </Shion/Rig/Joints/Ribbon/TailR_0/TailR_1/TailR_2>,
                        ] (
