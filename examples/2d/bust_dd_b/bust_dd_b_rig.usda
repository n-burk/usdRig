                def Scope "Neck"
                {
                    reorder nameChildren = ["SpineSkin", "BodyWarp"]
                    def RigExecLatticeMover "BodyWarp" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform token rigExec:basis = "bernstein"
                        rel rigExec:cage = </Shion/Cages/BodyCage> (
                            rigExecReadPhase = "final"
                        )
                        int3 rigExec:divisions = (6, 5, 2)
                        rel rigExec:moves = </Shion/Geom/Character.points>
                        rel rigExec:weightObject = </Shion/Rig/Weights/Neck>
                    }

                    def RigExecSkinMover "SpineSkin" (
                        prepend apiSchemas = ["RigExecMoverAPI"]
                    )
                    {
                        uniform int rigExec:elementSize = 3
                        rel rigExec:influences = [
                            </Shion/Rig/Joints/Body>,
                            </Shion/Rig/Joints/Body/Neck>,
                            </Shion/Rig/Joints/Body/Neck/Head>,
                        ] (
